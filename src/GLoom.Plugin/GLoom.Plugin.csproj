<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net7.0-windows because GH_Canvas uses WinForms types. Rhino 8 on Mac
         ships a WinForms compatibility shim that lets the .gha run anyway. -->
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Plugin metadata -->
    <Version>0.1.0</Version>
    <Title>G-Loom</Title>
    <Authors>iSamacA</Authors>
    <Company>iSamacA</Company>
    <Description>Version control for parametric Grasshopper systems. Branches, commits, tags, and on-canvas diffs over the recipe instead of the geometry.</Description>

    <!-- Output: a Grasshopper assembly is a .gha (renamed .dll) -->
    <AssemblyName>GLoom</AssemblyName>
    <RootNamespace>GLoom</RootNamespace>
    <TargetExt>.gha</TargetExt>

    <!-- GH_Canvas derives from System.Windows.Forms.Control; enable WinForms.
         EnableWindowsTargeting=true lets us build on macOS (the resulting plugin
         still runs cross-platform inside Rhino, which ships its own WinForms shim). -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- NU1701: Grasshopper NuGet targets net48 but works on net7 inside Rhino 8 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- IncludeAssets="compile;build" prevents the runtime DLL from being
         copied to bin/ - Rhino loads its own copy of Grasshopper. -->
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" IncludeAssets="compile;build" />

    <!-- System.Drawing.Common: compile-only; the .NET 7 host (Rhino) provides it at runtime. -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" IncludeAssets="compile" />
  </ItemGroup>

</Project>
