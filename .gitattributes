# Default
* text=auto eol=lf

# Source
*.cs text diff=csharp
*.csproj text
*.props text
*.targets text
*.sln text eol=crlf
*.sh text eol=lf
*.md text

# Grasshopper definition files
# .gh stays binary; the diff-friendly representation is the .gloom.json
# sidecar the plugin maintains, not a merge driver.
*.gh binary
*.ghx text eol=lf
*.ghcluster binary

# Image / icon assets
*.png binary
*.ico binary
*.jpg binary
